{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "drg",
  "main": "./src/worker-v5.ts",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true
    }
  }
}
